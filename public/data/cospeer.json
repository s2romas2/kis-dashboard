"eq":13696.0,"debt":59.1},"002210":{"n":"동성제약","pure":"low","gids":["md_pharma"],"top":"인접(미용의료)","seg":"제약 기반","flags":["씨앗 데이터 — PSR·OPM·분기매출은 DART 수집 후 채워집니다"],"kpbr":0.4,"kper":null,"cap":958,"px":992,"asof":"3Q26","fs":"OFS","ni":-396.0,"eq":595.2,"debt":165.1}},"groups":[{"id":"uv_org","name":"유기 자외선차단 원료(DHHB·BEMT·TDSA)","seg":"자외선차단 원료","top":"원료·소재","members":["453860"],"nopeer":[],"basis":"선크림의 자외선 차단 성분 중 유기계(화학자차)를 만드는 단계다. 유기계는 자외선차단제 시장의 약 60%를 차지한다.","caution":"국내 상장 비교군이 없다. 경쟁자는 BASF·DSM-Firmenich 등 글로벌 원료사이므로 국내 peer 멀티플 비교가 성립하지 않는다. 해외 원료사와 비교해야 한다.","src":"cospeer_v1"},{"id":"uv_inorg","name":"무기 자외선차단 소재·분산체(ZnO·TiO₂)","seg":"자외선차단 원료","top":"원료·소재","members":["086710"],"nopeer":[],"basis":"자외선을 물리적으로 반사하는 무기계(물리자차) 분말과 그 분산체를 만든다. 유기계와 달리 피부 자극이 낮아 민감성·영유아용에 쓰인다.","caution":"같은 '자외선차단 원료'라도 유기계(에이에스텍)와 무기계는 원료·공정·규제가 전혀 달라 직접 대체되지 않는다. 멀티플 비교 시 등급을 낮춰야 한다.","src":"cospeer_v1"},{"id":"pigment","name":"색소·진주광택안료","seg":"색소·안료","top":"원료·소재","members":["101240","900310"],"nopeer":[],"basis":"색조 화장품의 발색과 펄감을 만드는 안료다. 합성마이카에 얇은 막을 입혀 빛을 굴절시키는 진주광택안료가 핵심 품목이다.","caution":"컬러레이는 중국 소재 외국기업 상장사로 회계·공시 환경이 다르다. 씨큐브는 화장품 외 자동차 도료·전자 비중이 있어 화장품 순수도가 낮다.","src":"cospeer_v1"},{"id":"surfact","name":"계면활성제·정밀화학 원료","seg":"기초 화학소재","top":"원료·소재","members":["002840","036670","011500"],"nopeer":[],"basis":"세정·유화의 기본이 되는 계면활성제와 폴리머다. 거의 모든 제형에 들어가므로 특정 카테고리 유행을 덜 탄다.","caution":"세 회사 모두 화장품 외 산업용 비중이 크다. 전사 실적을 K-뷰티 성장의 대리지표로 쓰면 안 된다.","src":"cospeer_v1"},{"id":"bioactive","name":"천연물·펩타이드 기능성 소재","seg":"기능성 소재","top":"원료·소재","members":["078140","420570","052260","388610","251120","265740","214370","168330","086820"],"nopeer":[],"basis":"주름개선·미백·진정 같은 기능을 내는 활성 성분이다. 개별인정형 원료와 특허가 진입장벽을 만든다.","caution":"원료만 파는 곳, 원료의약품(API)을 겸하는 곳, 피부임상까지 파는 곳이 섞여 있다. 케어젠은 기능성 필러로, 대봉엘에스는 API로 매출 구성이 달라 멀티플이 벌어진다.","src":"cospeer_v1"},{"id":"sheet","name":"마스크 시트·특수 소재","seg":"부직포 소재","top":"원료·소재","members":["318160"],"nopeer":[],"basis":"시트마스크의 원단과 타공·삽입 소재를 만든다. 전방 마스크팩 물량에 직접 연동된다.","caution":"국내 상장 비교군이 사실상 없고(피앤씨랩스는 비상장), 자체 브랜드 매출이 섞여 순수 소재사로 보기 어렵다.","src":"cospeer_v1"},{"id":"clinical","name":"피부임상·효능 평가","seg":"인증·임상 인프라","top":"원료·소재","members":["347740"],"nopeer":[],"basis":"화장품의 효능·안전성을 사람 대상으로 검증하고 해외 등록을 대행한다. 브랜드와 원료사가 수출 전에 반드시 거치는 관문이다.","caution":"대봉엘에스 자회사라 지배구조상 중복 집계 주의. 수출 규제가 강화될수록 유리해지는 역방향 수혜라 브랜드 업황과 사이클이 다르다.","src":"cospeer_v1"},{"id":"pump","name":"화장품 펌프·디스펜서","seg":"용기·부자재","top":"부자재·용기","members":["251970"],"nopeer":[],"basis":"펌프·스포이드·에어리스 등 내용물을 토출하는 부품이다. 금형을 미리 갖고 있어야 브랜드의 다품종 소량 주문을 받을 수 있다.","caution":"상장 경쟁사 연우가 2022년 한국콜마에 인수된 뒤 상장시장에서 빠져 직접 비교군이 없다. 비상장 삼화·다린과는 멀티플 비교가 불가능하다.","src":"cospeer_v1"},{"id":"glass","name":"화장품 유리용기","seg":"용기·부자재","top":"부자재·용기","members":["460870","263920"],"nopeer":[],"basis":"유리 용기를 설계·성형·코팅·인쇄까지 처리한다. 용해로 같은 대형 설비가 필요해 고정비형이다.","caution":"두 회사 모두 유리용기를 하지만 휴엠앤씨는 의료용 부자재를 겸한다. 고정비형이라 매출이 꺾이면 마진이 급격히 무너진다 — 호황 PER을 그대로 쓰면 안 된다.","src":"cospeer_v1"},{"id":"pack","name":"종합 패키징·개발 턴키","seg":"용기·부자재","top":"부자재·용기","members":["014820","260930","016100"],"nopeer":[],"basis":"용기 기획부터 조달·생산을 묶어 제공하거나, 포장재 전반을 다룬다.","caution":"동원시스템즈는 화장품이 매출의 일부인 종합 포장사다. 리더스코스메틱은 WICS 분류상 포장재지만 실제로는 마스크팩 브랜드에 가깝다. 세 회사를 같은 잣대로 비교하면 안 된다.","src":"cospeer_v1"},{"id":"odm_all","name":"종합 화장품 ODM","seg":"종합 ODM","top":"OEM/ODM 제조","members":["192820","161890","241710"],"nopeer":[],"basis":"브랜드의 의뢰를 받아 처방 개발부터 생산까지 맡는다. 국내 3사가 식약처 ODM 생산실적 상위를 차지하고, 코스맥스·한국콜마는 글로벌 1·2위다.","caution":"카테고리 믹스가 달라 같은 '종합 ODM'이라도 업황 민감도가 다르다. 한국콜마는 선케어 32%, 코스맥스는 색조 비중이 높았다가 기초로 옮기는 중이다. 코스메카코리아는 북미(잉글우드랩) 비중이 커서 관세·환율 노출이 다르다.","src":"cospeer_v1"},{"id":"odm_sun","name":"선케어·미국 OTC ODM","seg":"선케어 ODM","top":"OEM/ODM 제조","members":["950140","003350"],"nopeer":[],"basis":"선크림은 미국에서 화장품이 아니라 OTC 의약품으로 분류된다. FDA OTC 대응 설비와 처방 이력이 있어야 수주가 가능해 공급자가 솎아진 영역이다.","caution":"잉글우드랩은 코스메카코리아 자회사라 모자 중복 집계 주의. 한국화장품제조는 선스틱 등 특정 제형 특화라 규모가 다르다.","src":"cospeer_v1"},{"id":"odm_color","name":"색조 ODM","seg":"색조 ODM","top":"OEM/ODM 제조","members":["352480"],"nopeer":[],"basis":"립·쿠션·아이 등 색조 전용 ODM이다. 자체 제형을 먼저 제안하고 브랜드가 그 위에 브랜딩을 얹는 구조로 옮겨가고 있다.","caution":"국내 상장 색조 전업 ODM이 사실상 한 곳뿐이라 peer 비교가 성립하지 않는다. 글로벌 경쟁자는 이탈리아 인터코스(비상장)다. 2026년 색조 수출 증가율이 0%로 꺾여 기초 ODM과 사이클이 분리됐다.","src":"cospeer_v1"},{"id":"odm_gel","name":"하이드로겔·마스크팩 ODM","seg":"특수 제형 ODM","top":"OEM/ODM 제조","members":["123330","250030","175250"],"nopeer":[],"basis":"하이드로겔 마스크는 자동화가 어려워 국내 공급사가 5~6곳으로 제한된다. 수율이 수익성을 지배한다.","caution":"수율 구간에 따라 원가율이 130%에서 90%까지 움직여 분기 실적 변동이 매우 크다. 한 분기 OPM으로 멀티플을 매기면 안 된다. 아이큐어는 경피약물전달(의약품)이 본업이라 성격이 다르다.","src":"cospeer_v1"},{"id":"odm_mn","name":"경피전달·마이크로니들","seg":"특수 제형 ODM","top":"OEM/ODM 제조","members":["214260"],"nopeer":[],"basis":"유효성분을 미세 바늘로 피부 안쪽에 전달하는 제형이다. 화장품 패치에서 의약품(탈모 패치)으로 올라가는 중이다.","caution":"국내외 비교군이 없다. 의약품 파이프라인 가치가 섞여 있어 화장품 ODM 멀티플로 평가하면 과소평가되고, 바이오 멀티플로 보면 과대평가된다.","src":"cospeer_v1"},{"id":"odm_brand","name":"제조·자체브랜드 병행","seg":"겸업 제조","top":"OEM/ODM 제조","members":["406820","226340","080530"],"nopeer":[],"basis":"수탁 생산과 자체 브랜드를 함께 한다. 자체 브랜드는 원가율이 낮아(인디 납품 약 30% vs 자체 약 15%) 마진이 좋지만 재고·마케팅 부담을 진다.","caution":"수탁 매출과 자체 브랜드 매출을 사업보고서에서 분리해야 한다. 섞어서 보면 ODM으로도 브랜드로도 설명되지 않는다.","src":"cospeer_v1"},{"id":"odm_inner","name":"이너뷰티·건기식 ODM","seg":"이너뷰티 ODM","top":"OEM/ODM 제조","members":["200130","222040"],"nopeer":[],"basis":"먹는 뷰티(콜라겐·이너뷰티) 건강기능식품을 수탁 생산한다. 화장품 ODM 그룹사의 자매 사업이다.","caution":"본업이 건강기능식품이라 화장품 수출 지표와 연동되지 않는다. 화장품 peer 멀티플을 적용하면 안 되고 건기식 업종과 비교해야 한다.","src":"cospeer_v1"},{"id":"br_major","name":"종합 대형 브랜드","seg":"대형 브랜드","top":"브랜드","members":["090430","051900","018250","078520","031430"],"nopeer":[],"basis":"여러 브랜드와 채널을 동시에 운영하는 대형사다. 해외 지역 믹스와 브랜드 믹스가 실적을 가른다.","caution":"중국 의존도가 크게 다르다(아모레퍼시픽 약 23%로 축소 vs LG생활건강 약 45%). 애경산업·신세계인터내셔날은 생활용품·패션 비중이 커서 화장품 순수도가 낮다. 전사 PER로 인디 브랜드와 비교하면 안 된다.","src":"cospeer_v1"},{"id":"br_device","name":"뷰티 디바이스 + 화장품","seg":"디바이스 융합","top":"브랜드","members":["278470"],"nopeer":[],"basis":"홈케어 디바이스와 화장품을 함께 팔아, 기기가 소모품(화장품) 재구매를 끌어오는 구조를 만든다.","caution":"국내 상장 비교군이 없다. 디바이스는 제조업 멀티플, 화장품은 브랜드 멀티플이라 단일 PER로 설명되지 않는다. 동국제약·셀리턴이 부분적으로 겹친다.","src":"cospeer_v1"},{"id":"br_indie","name":"인디 스킨케어 브랜드","seg":"인디 브랜드","top":"브랜드","members":["483650","018290","439090","0015N0"],"nopeer":[],"basis":"소수 히트 제품으로 해외에서 급성장한 중소형 브랜드다. 영업이익률이 대형사보다 높은 경우가 많다.","caution":"단일 제품 의존도가 높아 유행이 꺾이면 이익이 빠르게 줄어든다. 피크 이익에 PER을 곱하면 안 된다. 아로마티카는 2025년 11월 상장으로 비교 가능한 분기 수가 적고, 종목코드(0015N0)가 대시보드 재무 마스터에 아직 없어 수치가 비어 있을 수 있다.","src":"cospeer_v1"},{"id":"br_color","name":"색조 브랜드","seg":"색조 브랜드","top":"브랜드","members":["237880","114840","451250","083660"],"nopeer":[],"basis":"립·쿠션·아이섀도 등 색조 중심 브랜드다. 일본에서 강세였고 서구권은 쉐이드 수 문제로 진입이 어렵다.","caution":"2026년 색조 수출 증가율 0%(기초 19%)로 카테고리 자체가 눌렸다. 기초 브랜드와 같은 멀티플을 쓰면 안 된다. 서구권 매대는 최소 20개 쉐이드를 요구하는데 한국 제품은 보통 3개 호수다.","src":"cospeer_v1"},{"id":"br_derma","name":"더마·메디컬 브랜드","seg":"더마 브랜드","top":"브랜드","members":["092730","086450"],"nopeer":[],"basis":"피부 장벽·민감성에 특화된 기능성 브랜드다. 약국·병원 채널을 함께 쓰며 유행 주기를 덜 탄다.","caution":"동국제약은 제약이 본업이고 센텔리안24가 일부다. 전사 실적으로 네오팜과 비교하면 안 된다.","src":"cospeer_v1"},{"id":"br_hair","name":"헤어·두피 케어","seg":"헤어·스칼프","top":"브랜드","members":["252500","317240","344860"],"nopeer":[],"basis":"샴푸·트리트먼트·탈모 케어다. 스킨케어 다음 전장으로 떠오른 카테고리로, 미국 아마존에서 한국 두피 제품이 상위를 차지하고 있다.","caution":"세 회사 모두 단일 카테고리 집중이라 히트 제품 수명이 실적을 좌우한다. 광고선전비 비중을 함께 봐야 한다. 아로마티카·LG생활건강(닥터그루트)이 같은 매대의 경쟁자지만 분류가 달라 이 묶음에 없다.","src":"cospeer_v1"},{"id":"br_baby","name":"유아·가족 케어","seg":"유아 케어","top":"브랜드","members":["159580","014100"],"nopeer":[],"basis":"영유아·가족용 스킨케어와 생활용품이다. 안전성 기준이 높아 진입이 까다롭지만 시장이 출생아 수에 묶여 있다.","caution":"국내 출생아 수 감소가 구조적 역풍이다. 수출 성장 스토리로 K-뷰티 멀티플을 적용하기 어렵다.","src":"cospeer_v1"},{"id":"br_legacy","name":"레거시 로드숍·방판 브랜드","seg":"레거시 브랜드","top":"브랜드","members":["214420","123690","027050","226320","217480","227610"],"nopeer":[],"basis":"2010년대 로드숍·방문판매로 성장했던 브랜드다. 채널 구조 변화로 역성장 국면에 있다.","caution":"자산가치(PBR)는 낮지만 이익이 없어 저PBR이 저평가를 뜻하지 않는다. 한국화장품은 자회사 한국화장품제조(선스틱)가 오히려 성장축이라 지주 성격으로 봐야 한다.","src":"cospeer_v1"},{"id":"br_inner","name":"이너뷰티 브랜드","seg":"이너뷰티 브랜드","top":"브랜드","members":["270870","357230","377220"],"nopeer":[],"basis":"먹는 콜라겐·이너뷰티 건강기능식품 브랜드다. 소비자층이 화장품과 겹친다.","caution":"건강기능식품 규제와 채널(홈쇼핑·약국)을 따르므로 화장품 수출 지표와 연동되지 않는다.","src":"cospeer_v1"},{"id":"dist_vendor","name":"K뷰티 수출 벤더","seg":"수출 벤더","top":"유통·채널","members":["257720","362320"],"nopeer":[],"basis":"국내 인디 브랜드의 제품을 사들여 해외 현지에 공급한다. 브랜드가 직접 수출할 때보다 현금회수가 훨씬 빨라, 자본이 얇은 인디 브랜드가 이 경로를 쓴다.","caution":"유통업이라 매출총이익률이 낮고 운전자본(재고·매출채권)이 실적의 핵심이다. PER보다 재고회전과 회수기간을 먼저 봐야 한다. 브랜드가 직진출로 전환하면 매출이 이탈하는 구조적 리스크가 있다.","src":"cospeer_v1"},{"id":"dist_ec","name":"해외 전자상거래·유통","seg":"해외 유통","top":"유통·채널","members":["018700","137940","019660"],"nopeer":[],"basis":"역직구·현지 전자상거래로 화장품을 판다.","caution":"세 회사 모두 화장품 외 품목을 함께 다루고 규모가 작아 실적 변동이 크다. 실리콘투와 같은 멀티플을 적용하면 안 된다.","src":"cospeer_v1"},{"id":"hold","name":"지주·간접 관련","seg":"지주·간접","top":"지주·간접","members":["002790","024720","044820","126560","032940","025620","048410","090370","159910","219550","900300","244460"],"nopeer":[],"basis":"화장품 사업회사를 지배하거나, WICS 화장품 업종에 들어 있으나 본업이 화장품이 아닌 기업이다.","caution":"지주사는 자회사 실적이 연결로 들어와 PER·PBR이 사업회사와 다르게 나온다. 자회사와 같은 묶음에서 비교하면 안 된다. 오가닉티코스메틱은 중국 소재 외국기업 상장사다. 올리패스·현대바이오·원익은 현재 화장품 매출이 미미하다.","src":"cospeer_v1"},{"id":"md_hifu","name":"HIFU·RF 미용 의료기기","seg":"미용 장비","top":"인접(미용의료)","members":["214150","336570","450950","149980"],"nopeer":[],"basis":"초음파(HIFU)·고주파(RF)로 피부를 리프팅하는 장비다. 장비를 깔고 나면 소모품(카트리지·팁)에서 반복 매출이 나온다.","caution":"장비 매출과 소모품 매출의 비중이 회사마다 달라 이익의 질이 다르다. 소모품 비중이 높을수록 멀티플 프리미엄이 정당화된다. 화장품 업황과는 사이클이 다르다.","src":"cospeer_v1"},{"id":"md_laser","name":"레이저 미용 의료기기","seg":"미용 장비","top":"인접(미용의료)","members":["199550"],"nopeer":[],"basis":"색소·혈관 병변 치료용 레이저 장비다.","caution":"HIFU·RF와 적용 부위·소모품 구조가 달라 직접 비교가 어렵다.","src":"cospeer_v1"},{"id":"md_toxin","name":"보툴리눔 톡신","seg":"톡신·필러","top":"인접(미용의료)","members":["145020","086900","216080"],"nopeer":[],"basis":"주름 개선용 보툴리눔 톡신이다. 해외 품목허가가 성장의 관문이다.","caution":"균주 출처 분쟁 이력과 국가별 허가 진행 단계가 회사마다 달라 같은 멀티플을 쓰기 어렵다.","src":"cospeer_v1"},{"id":"md_filler","name":"HA 필러·스킨부스터","seg":"톡신·필러","top":"인접(미용의료)","members":["214450","200670","099430","240550"],"nopeer":[],"basis":"히알루론산 필러와 피부 재생을 돕는 스킨부스터다. 시술 시장과 홈케어 화장품을 잇는 위치다.","caution":"파마리서치는 리쥬란(PN)으로 카테고리가 다르고 화장품·의료기기를 함께 한다. 동방메디컬은 니들 등 의료소모품 비중이 있어 제품 구성이 다르다.","src":"cospeer_v1"},{"id":"md_regen","name":"재생의료 소재·세포치료","seg":"재생의료","top":"인접(미용의료)","members":["290650","085660","078160","217730","007390","005690"],"nopeer":[],"basis":"인체조직 이식재와 줄기세포 기반 치료·소재다. 일부가 화장품 원료·에스테틱으로 이어진다.","caution":"본업이 바이오라 임상 단계 가치가 멀티플을 지배한다. 화장품 매출은 부수적이므로 화장품 peer로 비교하면 안 된다.","src":"cospeer_v1"},{"id":"md_pharma","name":"제약 기반 뷰티","seg":"제약 기반","top":"인접(미용의료)","members":["195940","002210"],"nopeer":[],"basis":"제약사가 화장품·염모제 등 뷰티 품목을 함께 하는 경우다.","caution":"의약품 매출이 절대적이라 화장품 지표로 설명되지 않는다.","src":"cospeer_v1"}],"pairs":[],"debug":["씨앗 106종목 · 시세 없음 1 (아로마티카)"]}